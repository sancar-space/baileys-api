# Porta do servidor HTTP
PORT=3025

# Chave de autenticação da API (obrigatório — gere com: openssl rand -hex 32)
API_KEY=

# Redis para persistência de sessão
REDIS_URL=redis://localhost:6379

# URL de webhook para receber mensagens de entrada (ex: Chatwoot)
# Exemplo: https://chat.sancar.space/webhooks/whatsapp
WEBHOOK_URL=

# Nome da sessão WhatsApp (útil para multi-instância)
SESSION_NAME=default

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
