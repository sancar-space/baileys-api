# Porta do servidor HTTP
PORT=3025

# Chave de autenticação estática (alternativa ao manage-api-keys)
# Se definida, é sempre aceita como chave válida
API_KEY=

# Redis para persistência de sessão e API keys
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# URL de webhook para receber eventos (mensagens, conexão, QR)
# Exemplo: http://n8n:5678/webhook/whatsapp
WEBHOOK_URL=

# Diretório de armazenamento de sessões e mídia
STORAGE_PATH=/app/storage

# Limpeza automática de mídia
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INTERVAL_MS=3600000
MEDIA_MAX_AGE_HOURS=24

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=error
